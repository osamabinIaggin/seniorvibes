{
  "name": "seniorvibes",
  "displayName": "seniorvibes",
  "description": "Senior devs vibe coding — one-line directives become grounded code blocks.",
  "version": "0.0.1",
  "publisher": "seniorvibes",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "seniorvibes.ping",
        "title": "seniorvibes: ping"
      },
      {
        "command": "seniorvibes.generate",
        "title": "seniorvibes: generate"
      }
    ],
    "keybindings": [
      {
        "command": "seniorvibes.generate",
        "key": "shift+enter",
        "when": "editorTextFocus && seniorvibes.onDirectiveLine && !suggestWidgetVisible"
      }
    ],
    "configuration": {
      "title": "seniorvibes",
      "properties": {
        "seniorvibes.sentinel": {
          "type": "string",
          "default": "$#",
          "markdownDescription": "Trigger token that marks the rest of a line as a directive. May appear after existing code on the line. Regex-escaped automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "verify": "npm run check-types && npm run lint && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
